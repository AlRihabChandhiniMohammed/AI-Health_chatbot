{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account registration and preferences information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique Google user ID" },
        "email": { "type": "string", "description": "Email address of the user" },
        "displayName": { "type": "string", "description": "Display name of the user" },
        "photoURL": { "type": "string", "description": "URL to the user's profile icon" },
        "language": { "type": "string", "description": "User preferred interface language", "enum": ["en", "hi", "te"] },
        "createdAt": { "type": "string", "format": "date-time", "description": "Registration audit timestamp" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Chat": {
      "title": "Session Chat",
      "description": "Virtual consultation chat session details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique session chat ID" },
        "userId": { "type": "string", "description": "References the User profile" },
        "title": { "type": "string", "description": "Name given to this chat thread" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Chat Message",
      "description": "Individual communication piece under a specific thread",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique message ID" },
        "text": { "type": "string", "description": "Plaintext message content" },
        "sender": { "type": "string", "description": "Message author", "enum": ["user", "model"] },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["id", "text", "sender", "createdAt"]
    },
    "SymptomCheck": {
      "title": "Symptom Checker Entry",
      "description": "User check-ups detailing symptoms, demographic information, and clinical models report",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique record check ID" },
        "userId": { "type": "string", "description": "References the User profile" },
        "symptoms": { "type": "string", "description": "Entered text describing symptoms" },
        "age": { "type": "integer", "description": "User age in years" },
        "gender": { "type": "string", "description": "Assigned sex or gender", "enum": ["Male", "Female", "Other"] },
        "duration": { "type": "string", "description": "Timeline of symptomatology" },
        "severity": { "type": "string", "description": "Intensity level", "enum": ["Mild", "Moderate", "Severe"] },
        "results": {
          "type": "string",
          "description": "JSON string or markdown from the AI analyzing conditions and actions"
        },
        "createdAt": { "type": "string", "format": "date-time", "description": "Check-up execution timestamp" }
      },
      "required": ["id", "userId", "symptoms", "age", "gender", "duration", "severity", "results", "createdAt"]
    },
    "SavedDoctor": {
      "title": "Saved Doctor",
      "description": "Saved professional reference",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Composite mapping or autogenerated ID" },
        "userId": { "type": "string", "description": "References the User profile" },
        "doctorId": { "type": "string", "description": "Doctor unique reference ID" },
        "doctorName": { "type": "string", "description": "Full formal name" },
        "specialization": { "type": "string", "description": "Professional field specialty" },
        "experience": { "type": "integer", "description": "Years of expertise" },
        "rating": { "type": "number", "description": "Clinic rating index" },
        "hospitalAffiliation": { "type": "string", "description": "Hospital associated name" },
        "availability": { "type": "string", "description": "Clinician scheduling tag" },
        "consultationFee": { "type": "integer", "description": "Estimated patient consult price" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Save date mapping" }
      },
      "required": ["id", "userId", "doctorId", "doctorName", "specialization", "createdAt"]
    },
    "SavedHospital": {
      "title": "Saved Hospital",
      "description": "Saved geographical hospital or laboratory profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Static mapping identifier" },
        "userId": { "type": "string", "description": "References the User profile" },
        "hospitalId": { "type": "string", "description": "Google Places place_id reference" },
        "name": { "type": "string", "description": "Hospital formal name designation" },
        "rating": { "type": "number", "description": "Hospital review score index" },
        "address": { "type": "string", "description": "Geographical address coordinates or street path" },
        "phone": { "type": "string", "description": "Public office number" },
        "website": { "type": "string", "description": "Hospital public landing page URL" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Audit creation timestamp" }
      },
      "required": ["id", "userId", "hospitalId", "name", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User personal preferences and profile registration"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Medical AI chat session threads"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Constituents of an AI discussion thread"
    },
    "/symptomChecks/{checkId}": {
      "schema": "SymptomCheck",
      "description": "Detailed clinical check history logs"
    },
    "/savedDoctors/{saveId}": {
      "schema": "SavedDoctor",
      "description": "Users individual shortlists of doctor references"
    },
    "/savedHospitals/{saveId}": {
      "schema": "SavedHospital",
      "description": "Users individual shortlists of hospitals and diagnostic clinics"
    }
  }
}
